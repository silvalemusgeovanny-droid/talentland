CONVEX_URL=https://tu-proyecto.convex.cloud
TELEGRAM_BOT_TOKEN=123456789:token_de_botfather
TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_REQUIRE_AUTH=true
TELEGRAM_SILENT_UNAUTHORIZED=true
# El acceso a datos depende de /login y los modulos del usuario.
# Esta cuenta interna solo se usa para la bitacora del bot.
TELEGRAM_APP_USERNAME=usuario_del_bot
TELEGRAM_APP_PASSWORD=contrasena_del_bot
TELEGRAM_MAX_RESULTS=8
GOOGLE_AI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash
EXA_API_KEY=tu_api_key_de_exa
EXA_MAX_RESULTS=5
CONVERSATION_MEMORY_LIMIT=8
# Notificaciones proactivas del bot (requieren iniciar sesion en el chat)
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_INTERVAL_MINUTES=30
NOTIFICATIONS_DAILY_HOUR=18
GOOGLE_DRIVE_BACKUP_WEBHOOK_URL=https://script.google.com/macros/s/...
GOOGLE_DRIVE_BACKUP_SECRET=clave_compartida_con_apps_script
HEALTH_MONITOR_SECRET=clave_larga_y_aleatoria_compartida_con_apps_script
BACKUP_ENCRYPTION_KEY=clave_larga_para_cifrar_backups
BACKUP_MANUAL_RUN_SECRET=clave_separada_para_ejecutar_backups_manual
SETUP_SEED_SECRET=REPLACE_WITH_A_RANDOM_ONE_TIME_SECRET
INITIAL_ADMIN_USERNAME=REPLACE_WITH_THE_INITIAL_ROOT_USERNAME
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
